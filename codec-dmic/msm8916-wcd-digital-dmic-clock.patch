+/*
+ * DMIC clock divider: the fastest DMIC clock not above the requested rate. The DMIC
+ * clock generator and every decimator fed by a DMIC must use the same setting.
+ */
+static unsigned int msm8916_wcd_digital_dmic_clk_sel(struct snd_soc_component *component)
+{
+	static const unsigned int divs[] = { 2, 3, 4, 6, 16 };	/* CLK_SEL 0..4 */
+	struct msm8916_wcd_digital_priv *priv = snd_soc_component_get_drvdata(component);
+	unsigned long mclk = clk_get_rate(priv->mclk);
+	unsigned int sel;
+
+	if (!mclk)
+		return TXN_DMIC_CTL_CLK_SEL_DIV3;
+
+	for (sel = 0; sel < ARRAY_SIZE(divs) - 1; sel++)
+		if (mclk / divs[sel] <= priv->dmic_clk_rate)
+			break;
+
+	return sel;
+}
