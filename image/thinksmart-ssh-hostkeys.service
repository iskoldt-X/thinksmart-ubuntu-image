[Unit]
Description=Create this device's own SSH host keys (the release image ships none)
ConditionPathExists=!/etc/ssh/ssh_host_ed25519_key
# No default dependencies: they add After=basic.target, and with Before=ssh.socket that is an
# ordering cycle (sockets.target is part of basic.target), which systemd breaks by dropping a job
DefaultDependencies=no
After=local-fs.target
Before=ssh.service ssh.socket

[Service]
Type=oneshot
ExecStart=/usr/bin/ssh-keygen -A

[Install]
WantedBy=sysinit.target
